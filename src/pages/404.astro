---
import Zaklad from '../layouts/Zaklad.astro';
---

<Zaklad titulek="Stránka nenalezena" popis="Požadovaná stránka na webu neexistuje.">
	<section class="hero">
		<div class="obal">
			<span class="stitek">Chyba 404</span>
			<h1>Tahle stránka tu není</h1>
			<p class="perex">
				Odkaz je nejspíš zastaralý nebo v adrese vznikl překlep. Zkuste to z
				<a href="/">úvodní stránky</a>.
			</p>
		</div>
	</section>
</Zaklad>
